%% Agentic Patterns Catalog — component architecture (SP1) and sub-project roadmap.
%% Source of truth for this diagram: docs/superpowers/specs/2026-09-12-agentic-patterns-catalog-design.md
flowchart TB
  subgraph inputs["Inputs (local only, not redistributed)"]
    mirror["agentic-design-mirror<br/>pages/raw/**  (RSC payload)"]
    pack["patterns-pack-free<br/>data/patterns.json (11 records, licensed)"]
  end

  subgraph l0["L0 — Extract / seed"]
    extract["catalog extract<br/>RSC JSON → pattern records"]
    seed["catalog seed<br/>pack JSON → same schema"]
  end

  subgraph store["Store &amp; Ledger (interfaces)"]
    subgraph stores["Store {file, pg}"]
      files[("FileStore<br/>catalog/patterns/**.json<br/>default, bare install")]
      pg_store[("PostgresStore<br/>5 tables · merged docs<br/>optional, extra 'pg'")]
    end
    subgraph ledgers["Ledger {jsonl, pg}"]
      jsonl_ledger[("JsonlLedger<br/>var/activity.jsonl<br/>default")]
      pg_ledger[("PostgresLedger<br/>activity table<br/>optional, extra 'pg'")]
    end
  end

  subgraph l1["L1 — Enrich"]
    enrich["catalog enrich<br/>LLM draft → review file"]
    review["catalog review<br/>reviewed_by, provenance"]
  end

  subgraph l2["L2 — Compile"]
    compile["catalog compile"]
    catmd["CATALOG.md<br/>one line per pattern"]
    guides["guides/&lt;category&gt;.md"]
    sheets["reference sheets"]
    recipes["recipes/*.json<br/>drone-flight-plan"]
    emb["embeddings (fastembed)"]
  end

  subgraph l3["L3 — Serve"]
    select["select()<br/>facets → BM25 ∥ semantic → RRF"]
    server["server.py (catalog serve)<br/>stdio / HTTP + Google OAuth"]
    mcp["FastMCP 4 server<br/>list_categories · search_patterns<br/>get_pattern · get_example · select · put_pattern"]
    cli["CLI  catalog …"]
    middleware["PolicyMiddleware<br/>runs before tool body"]
    subgraph pdp_group["PDP {Allowlist, OPA}"]
      pdp["PolicyDecisionPoint (interface)"]
      allowlist["AllowlistPDP (default)"]
      opa_pdp["OpaPDP (HTTP)"]
    end
    opa["opa run --server<br/>policy/catalog/authz.rego"]
  end

  subgraph consumers["Consumers"]
    skill["Claude Code skill<br/>SKILL.md → CATALOG.md → GUIDE → record"]
    py["Python agent (LangGraph)"]
    kt["Kotlin agent (Embabel + Spring AI MCP client)"]
  end

  subgraph verify["Verification"]
    eval["catalog eval<br/>golden tasks → docs/data/eval.json"]
    ver["catalog verify<br/>schema · index · relations DAG · budgets · eval"]
  end

  mirror --> extract --> files
  pack --> seed --> files
  files -- "sync-pg" --> pg_store
  files --> enrich --> review --> files
  files --> compile
  compile --> catmd & guides & sheets & recipes & emb
  files --> select
  pg_store -. "CATALOG_STORE=pg" .-> select
  emb --> select
  select --> mcp
  select --> cli
  server --> mcp
  mcp --> middleware
  middleware --> pdp
  pdp --> allowlist & opa_pdp
  opa_pdp -. "HTTP" .-> opa
  middleware -- "append (allow/deny/result)" --> jsonl_ledger & pg_ledger
  mcp --> skill & py & kt
  catmd --> skill
  py -. checkpoints .-> pg_store
  files --> eval --> ver
  compile --> ver
  pg_store -. "verify pg" .-> ver

  subgraph roadmap["Roadmap (each: own ADR + spec)"]
    direction LR
    SP1["SP1 Catalog v1<br/>(this diagram)"] --> SP2["SP2 Persistence + ledger"]
    SP1 --> SP3["SP3 Policy / OPA"]
    SP1 --> SP4["SP4 Recipe DSL"]
    SP4 --> SP5["SP5 Drone fleet blueprint"]
    SP5 --> SP6["SP6 Composer"]
    SP2 & SP5 --> SP7["SP7 BML loop + digital twin"]
    SP5 --> SP8["SP8 Edge / cloud deploy"]
  end
