{
  "$defs": {
    "Enrichment": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "method": {
          "enum": [
            "llm-draft",
            "human",
            "derived"
          ],
          "title": "Method",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        }
      },
      "required": [
        "method",
        "date"
      ],
      "title": "Enrichment",
      "type": "object"
    },
    "ImplementationGuide": {
      "additionalProperties": false,
      "properties": {
        "bestPractices": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Bestpractices",
          "type": "array"
        },
        "commonPitfalls": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Commonpitfalls",
          "type": "array"
        },
        "whenToUse": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Whentouse",
          "type": "array"
        }
      },
      "title": "ImplementationGuide",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "enrichment": {
          "additionalProperties": {
            "$ref": "#/$defs/Enrichment"
          },
          "default": {},
          "title": "Enrichment",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "extraction": {
          "enum": [
            "rsc-payload",
            "free-pack"
          ],
          "title": "Extraction",
          "type": "string"
        },
        "mirrored_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mirrored At"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "extraction",
        "content_sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$id": "https://github.com/cdevarenne/agentic-patterns-catalog/schema/category.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "detailedDescription": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detaileddescription"
    },
    "id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "implementationGuide": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImplementationGuide"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "technique_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Technique Ids",
      "type": "array"
    },
    "whyImportant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Whyimportant"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "provenance"
  ],
  "title": "Category",
  "type": "object"
}
